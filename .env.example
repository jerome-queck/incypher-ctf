# Copy to `.env` (gitignored) and fill in. Never commit the real values: the conformance check
# scans every pull request for credentials, but it fires after the push — a committed key is
# burned and must be rotated first, then removed (CONTRIBUTING.md).

# The IN-CYPHER team key. It identifies and gates this team on the competition platform and
# must stay within the team.
TEAM_KEY=

# LLM provider keys the solver uses. Add or remove providers as the stack settles.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
