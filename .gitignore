# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Env / secrets
.env
.env.*
# but the committed template is not a secret — it is what a real .env is copied from
!.env.example
*.local

# Python
__pycache__/
*.pyc

# Agent worktrees — scratch checkouts, never part of the tree
.claude/worktrees/

# Tool caches. `pyproject.toml` points ruff and pytest here so the root grows one disposable
# directory rather than one per tool; MAP.md carries its row.
.cache/
